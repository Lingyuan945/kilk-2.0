# ===== kilk 2.0 专属 =====

# 敏感配置（含数据库密码、JWT密钥）
.env
.env.*
!.env.example

# 嵌入式数据库数据目录（PGlite 已废弃，本地使用原生 PostgreSQL）
server/pg-local-data/
server/pg-local-data-backup/

# 临时 token 文件
server/scripts/*.txt

# 服务器日志
server/*.log
server/err.log
server/server_out.log
server/server_err.log

# 数据库迁移临时文件
server/truncate.sql

# 数据导出（含密码哈希等敏感数据，如需备份请使用私有仓库或本地保留）
server/data-export/

# Environment files (sensitive)
.env
.env.*
!.env.example

# 部署临时产物
server/*.tar.gz
server/kilk_db_dump.sql
server/db_dump.sql
